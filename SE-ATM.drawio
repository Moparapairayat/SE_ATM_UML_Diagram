        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Bank {\n        -String bankId\n        -String bankName\n        +verifyCredentials(cardNumber, pin) bool\n        +processTransaction(transaction) bool\n    }\n\n    class Customer {\n        -String customerId\n        -String name\n        -String cardNumber\n        -String pin\n        +insertCard()\n        +enterPIN(pin) bool\n        +selectTransaction()\n    }\n\n    class ATMTechnician {\n        -String technicianId\n        -String name\n        +authenticateTechnician() bool\n        +performMaintenance(atm)\n    }\n\n    class ATM {\n        -String atmId\n        -double currentCashBalance\n        -int paperLevel\n        -int inkLevel\n        +authenticateUser(cardNo, pin) bool\n        +executeTransaction(tx) bool\n        +replenishCash(amount)\n        +replenishSupplies(paper, ink)\n        +runDiagnostics() String\n    }\n\n    class CardReader {\n        -bool isCardInserted\n        +readCardData() String\n        +ejectCard()\n    }\n\n    class CashDispenser {\n        -double cashAvailable\n        +dispenseCash(amount) bool\n    }\n\n    class Printer {\n        -bool paperStatus\n        +printReceipt(tx)\n    }\n\n    class Account {\n        &lt;&lt;abstract&gt;&gt;\n        -String accountNumber\n        -double balance\n        +getBalance() double\n        +credit(amount)\n        +debit(amount) bool\n    }\n\n    class SavingsAccount {\n        -double interestRate\n    }\n\n    class CurrentAccount {\n        -double overdraftLimit\n    }\n\n    class Transaction {\n        &lt;&lt;abstract&gt;&gt;\n        -String transactionId\n        -Date date\n        -double amount\n        +execute() bool\n    }\n\n    class Withdrawal {\n        +execute() bool\n    }\n\n    class Deposit {\n        +execute() bool\n    }\n\n    class MaintenanceLog {\n        -String logId\n        -Date timestamp\n        -String actionDetails\n        +recordLog()\n    }\n\n    %% Relationships\n    Customer \&quot;1\&quot; -- \&quot;1..*\&quot; Account : owns\n    Customer \&quot;1\&quot; ..&gt; \&quot;1\&quot; ATM : uses\n    Bank \&quot;1\&quot; -- \&quot;1..*\&quot; Account : manages\n    Bank \&quot;1\&quot; -- \&quot;1..*\&quot; ATM : operates\n\n    ATM \&quot;1\&quot; *-- \&quot;1\&quot; CardReader\n    ATM \&quot;1\&quot; *-- \&quot;1\&quot; CashDispenser\n    ATM \&quot;1\&quot; *-- \&quot;1\&quot; Printer\n    ATM \&quot;1\&quot; -- \&quot;*\&quot; Transaction : processes\n\n    Account &lt;|-- SavingsAccount\n    Account &lt;|-- CurrentAccount\n\n    Transaction &lt;|-- Withdrawal\n    Transaction &lt;|-- Deposit\n    Transaction \&quot;*\&quot; -- \&quot;1\&quot; Account : affects\n\n    ATMTechnician \&quot;1\&quot; -- \&quot;*\&quot; ATM : maintains\n    ATMTechnician \&quot;1\&quot; ..&gt; \&quot;*\&quot; MaintenanceLog : creates\n    ATM \&quot;1\&quot; -- \&quot;*\&quot; MaintenanceLog : keeps&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="nDM_AlNhNq9m7m8Fwjgy-2">
